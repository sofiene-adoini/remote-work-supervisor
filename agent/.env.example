# Remote Work Supervisor — Desktop Agent configuration
# Copy to `.env` next to this file (agent/.env) and adjust. The `.env` file
# is gitignored; ship defaults live in src/config/config.js.
#
# Environment separation:
#   - agent/.env            → local/development overrides (gitignored)
#   - agent/.env.<AGENT_ENV> → layered on top when AGENT_ENV is set, e.g.
#     AGENT_ENV=test loads .env.test, AGENT_ENV=prod loads .env.prod.
#   - Real process env vars always win over both files.
# Inline comments are supported: KEY=value # note (a " #" starts a comment).

# Backend HTTP API base URL (must end in /api).
# type: string
AGENT_API_BASE_URL=http://localhost:1337/api

# Backend Socket.IO server origin (no trailing slash).
# type: string
AGENT_SERVER_URL=http://localhost:1337

# Heartbeat interval in milliseconds. Default: 300000 (5 min).
# type: number
AGENT_HEARTBEAT_MS=300000

# Access-token auto-refresh interval in milliseconds. Default: 3300000 (55 min).
# type: number
AGENT_REFRESH_MS=3300000

# Idle detection threshold in milliseconds. Default: 300000 (5 min).
# type: number
AGENT_IDLE_THRESHOLD_MS=300000

# Auto-break cutoff (inactivity before automatic break) in milliseconds. Default: 900000 (15 min).
# type: number
AGENT_AUTO_BREAK_THRESHOLD_MS=900000



# Activity check polling interval in milliseconds. Default: 30000 (30 s).
# type: number
AGENT_CHECK_INTERVAL_MS=30000


# Screenshot capture interval in milliseconds. Default: 600000 (10 min).
# type: number
AGENT_CAPTURE_INTERVAL_MS=600000


