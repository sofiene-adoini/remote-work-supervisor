# Remote Work Supervisor — Desktop Agent TEST overrides.
# Loaded on top of agent/.env when AGENT_ENV=test is set, e.g.:
#   $env:AGENT_ENV = "test"; npm start
# Remove test overrides from agent/.env so production defaults stay intact.

# Idle detection threshold (0.5 min) — fires the active→idle transition + reportIdle.
AGENT_IDLE_THRESHOLD_MS=30000

# Auto-break cutoff (1 min) — starts a break after this long without input.
AGENT_AUTO_BREAK_THRESHOLD_MS=60000

# Activity check polling interval (5 s) — how often idle is evaluated.
AGENT_CHECK_INTERVAL_MS=5000

# Screenshot capture interval (15 s) — how often screenshots are analyzed.
# Note: 'suspicious' needs 3 consecutive low-diff captures after a baseline,
# i.e. 4 captures ≈ 60 s of a static screen, so raise AUTO_BREAK above that
# when testing screenshot analysis.
AGENT_CAPTURE_INTERVAL_MS=15000
