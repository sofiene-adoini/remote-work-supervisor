{
  "kind": "collectionType",
  "collectionName": "overtime_declarations",
  "info": {
    "singularName": "overtime-declaration",
    "pluralName": "overtime-declarations",
    "displayName": "Overtime Declaration"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "date": {
      "type": "date",
      "required": true
    },
    "workedMinutes": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "expectedMinutes": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "overtimeMinutes": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "reason": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["detected", "submitted", "pending", "approved", "rejected", "cancelled"],
      "default": "detected",
      "required": true
    },
    "justificationSubmittedAt": {
      "type": "datetime"
    },
    "reviewedAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "overtimeDeclarations"
    },
    "session": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session.session"
    },
    "reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
