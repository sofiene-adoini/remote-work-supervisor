{
  "kind": "collectionType",
  "collectionName": "project_time_allocations",
  "info": {
    "singularName": "project-time-allocation",
    "pluralName": "project-time-allocations",
    "displayName": "Project Time Allocation"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "startTime": {
      "type": "datetime",
      "required": true
    },
    "endTime": {
      "type": "datetime"
    },
    "durationMinutes": {
      "type": "integer",
      "default": 0
    },
    "autoGenerated": {
      "type": "boolean",
      "default": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "projectTimeAllocations"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "projectTimeAllocations"
    },
    "session": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session.session",
      "inversedBy": "projectTimeAllocations"
    }
  }
}
