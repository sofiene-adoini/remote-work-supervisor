{
  "kind": "collectionType",
  "collectionName": "alerts",
  "info": {
    "singularName": "alert",
    "pluralName": "alerts",
    "displayName": "Alert"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "type": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "severity": {
      "type": "enumeration",
      "enum": ["info", "warning", "critical"],
      "default": "info",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "alerts"
    },
    "session": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session.session",
      "inversedBy": "alerts"
    }
  }
}
