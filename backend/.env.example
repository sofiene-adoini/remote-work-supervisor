# Server
# type: string (hostname or IP)
HOST=<server_host>
# type: number
PORT=<server_port>

# Database
# type: enum(postgres|mysql|sqlite)
DATABASE_CLIENT=<database_client>
# type: string (hostname)
DATABASE_HOST=<database_host>
# type: number
DATABASE_PORT=<database_port>
# type: string
DATABASE_NAME=<database_name>
# type: string
DATABASE_USERNAME=<database_username>
# type: string (secret)
DATABASE_PASSWORD=<database_password>
# type: boolean(true|false)
DATABASE_SSL=<database_ssl>

# Strapi secrets
# type: string (comma-separated, secret)
APP_KEYS=<app_keys_csv>
# type: string (secret)
API_TOKEN_SALT=<api_token_salt>
# type: string (secret)
ADMIN_JWT_SECRET=<admin_jwt_secret>
# type: string (secret)
TRANSFER_TOKEN_SALT=<transfer_token_salt>
# type: string (secret)
JWT_SECRET=<jwt_secret>
# type: string (secret)
ENCRYPTION_KEY=<encryption_key>

# Auth sessions (users-permissions refresh-token cookie)
# Mark the httpOnly refresh cookie as Secure so browsers only send it over HTTPS.
# Keep false for local HTTP dev; set true in production.
# type: boolean(true|false)
SESSION_COOKIE_SECURE=<session_cookie_secure>

# CORS for browser apps consuming the refresh cookie (httpOnly credentials flow)
# Comma-separated list of allowed origins, or * (note: "*" cannot be used with credentials).
# Leave blank to rely on default Strapi CORS (no credentials).
# type: string
CORS_ORIGIN=<cors_origin_csv>

# Email (SMTP) — used for invite and reset-password emails
# type: string
SMTP_HOST=<smtp_host>
# type: number
SMTP_PORT=<smtp_port>
# Use TLS from the first connection when true (e.g. port 465); STARTTLS when false (e.g. port 587).
# type: boolean(true|false)
SMTP_SECURE=<smtp_secure>
# type: string (secret)
SMTP_USER=<smtp_user>
# type: string (secret)
SMTP_PASS=<smtp_password>
# type: string (email)
SMTP_FROM=<sender_email>

# Auth sessions (users-permissions refresh-token cookie) — optional overrides
# Access JWT lifetime in seconds. Default: 3600 (1 hour).
# type: number
SESSION_ACCESS_TOKEN_LIFESPAN=<seconds>
# Refresh token max lifetime in seconds. Default: 604800 (7 days).
# type: number
SESSION_MAX_REFRESH_LIFESPAN=<seconds>
# Refresh token idle lifetime in seconds. Default: 604800 (7 days).
# type: number
SESSION_IDLE_REFRESH_LIFESPAN=<seconds>
# Auth endpoint rate limit. Defaults: 60000 ms window / 5 attempts.
# type: number
SESSION_RATELIMIT_INTERVAL=<milliseconds>
SESSION_RATELIMIT_MAX=<count>

# Desktop agent pairing — optional overrides
# How long a paired device stays trusted in days. Default: 90.
# type: number
AGENT_TRUST_DURATION_DAYS=<days>
# Pairing code TTL in seconds. Default: 60.
# type: number
AGENT_PAIR_CODE_TTL_SECONDS=<seconds>
# Pairing-code request rate limit. Defaults: 60000 ms window / 5 attempts.
# type: number
AGENT_PAIR_RATE_LIMIT_WINDOW_MS=<milliseconds>
AGENT_PAIR_RATE_LIMIT_MAX=<count>

# Realtime agent offline grace before auto clock-out, in milliseconds. Default: 15000.
# type: number
OFFLINE_GRACE_MS=<milliseconds>
